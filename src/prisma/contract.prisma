// use prisma-8

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SuperAdmin
  Admin
  Staff
}

enum AppointmentStatus {
  Scheduled
  Completed
  Canceled
  NoShow
}

enum InvoiceStatus {
  Unpaid
  Partial
  Paid
}

enum PaymentMethod {
  Cash
  Card
  Transfer
  Insurance
}

enum ClinicType {
  Dentistry
  Therapy
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Clinic {
  id          String                     @id @default(uuid())
  name        String
  clinic_type ClinicType
  timezone    String                     @default("UTC") // IANA zone (e.g. "Asia/Beirut"): what "today" and "09:00" mean for this clinic
  currency    String                     @default("USD") // ISO 4217 code (e.g. "USD", "EUR"): how this clinic's amounts are shown
  // Appointment reminder emails to patients: off until an admin turns them on
  reminders_enabled    Boolean @default(false)
  reminder_days_before Int     @default(1) // 1–7: the reminder goes out this many days before the visit
  created_at  temporal.createdAtString()
  updated_at  temporal.updatedAtString()

  users        User[]
  patients     Patient[]
  appointments Appointment[]
  invoices     Invoice[]
  payments     Payment[]  
}

model User {
  id            String                     @id @default(uuid())
  clinic_id     String? // Null for SuperAdmin
  clinic        Clinic?                    @relation(fields: [clinic_id], references: [id])
  role          UserRole
  first_name    String
  last_name     String
  email         String                     @unique
  password_hash String
  created_by_id String? // Who created this user; access removed from them is removed from this user too
  created_at    temporal.createdAtString()
  updated_at    temporal.updatedAtString()

  permissions     UserPermission[]
  appointments    Appointment[]
  password_resets PasswordResetToken[]

  @@index([clinic_id])
  @@index([created_by_id])
}

model UserPermission {
  id          String                     @id @default(uuid())
  user_id     String
  user        User                       @relation(fields: [user_id], references: [id])
  module_name String // e.g., Appointments, Patients, Invoices, Settings
  can_view    Boolean                    @default(false)
  can_create  Boolean                    @default(false)
  can_edit    Boolean                    @default(false)
  can_delete  Boolean                    @default(false)
  updated_at  temporal.updatedAtString()

  @@unique([user_id, module_name])
  @@index([user_id])
}

// A "set a new password" link sent by email. Only the SHA-256 of the token is
// stored (the link holds the token itself); it works once, until expires_at.
model PasswordResetToken {
  id         String                     @id @default(uuid())
  user_id    String
  user       User                       @relation(fields: [user_id], references: [id])
  token_hash String                     @unique
  expires_at TimestamptzString
  used_at    TimestamptzString?
  created_at temporal.createdAtString()

  @@index([user_id])
}

// One failed attempt at something guarded by a limit (signing in, confirming the
// current password). `key` names what was tried, e.g. "login:<email>" or
// "password:<user id>"; rows older than a day are pruned.
model AuthAttempt {
  id         String                     @id @default(uuid())
  key        String
  created_at temporal.createdAtString()

  @@index([key, created_at])
  @@index([created_at])
}

model Patient {
  id               String                     @id @default(uuid())
  clinic_id        String
  clinic           Clinic                     @relation(fields: [clinic_id], references: [id])
  first_name       String
  last_name        String
  email            String?
  phone            String?
  date_of_birth    DateString?
  gender           String?
  specialized_data Json? // Clinic-specific data
  created_at       temporal.createdAtString()
  updated_at       temporal.updatedAtString()
  deleted_at       TimestamptzString?

  medicalHistory SharedMedicalHistory?
  documents      PatientDocument[]
  appointments   Appointment[]
  invoices       Invoice[]

  @@index([clinic_id])
}

model SharedMedicalHistory {
  id                  String                     @id @default(uuid())
  patient_id          String                     @unique
  patient             Patient                    @relation(fields: [patient_id], references: [id])
  blood_type          String?
  allergies           String?
  chronic_conditions  String?
  current_medications String?
  last_updated        temporal.updatedAtString()
}

model PatientDocument {
  id            String                     @id @default(uuid())
  patient_id    String
  patient       Patient                    @relation(fields: [patient_id], references: [id])
  name          String
  // Exactly one of file_url (a link to a file hosted elsewhere) or storage_key (a file uploaded to our bucket)
  file_url      String?
  storage_key   String?                    @unique // Object key in the S3-compatible bucket
  file_name     String? // Original file name of an upload
  mime_type     String? // Content type of an upload, as stored in the bucket
  size_bytes    Int? // Size of an upload, as stored in the bucket
  document_type String?
  uploaded_at   temporal.createdAtString()

  @@index([patient_id])
}

model Appointment {
  id               String                     @id @default(uuid())
  clinic_id        String
  clinic           Clinic                     @relation(fields: [clinic_id], references: [id])
  patient_id       String
  patient          Patient                    @relation(fields: [patient_id], references: [id])
  user_id          String? // Nullable if booked online but not yet assigned to specific staff
  staff            User?                      @relation(fields: [user_id], references: [id])
  scheduled_time   TimestamptzString
  duration_minutes Int                        @default(30)
  status           AppointmentStatus          @default(Scheduled)
  reason_for_visit String?
  reminder_sent_at TimestamptzString? // When the reminder email went out (reset when the time changes)
  created_at       temporal.createdAtString()
  updated_at       temporal.updatedAtString()

  invoices Invoice[]
  payments Payment[]

  @@index([clinic_id, scheduled_time])
  @@index([scheduled_time]) // the reminder job scans upcoming visits across clinics
  @@index([patient_id])
  @@index([user_id])
}

model Invoice {
  id             String                     @id @default(uuid())
  clinic_id      String
  clinic         Clinic                     @relation(fields: [clinic_id], references: [id])
  patient_id     String
  patient        Patient                    @relation(fields: [patient_id], references: [id])
  appointment_id String? // Nullable for walk-in payments, standalone products, or generic consultations
  appointment    Appointment?               @relation(fields: [appointment_id], references: [id])
  title          String? // What is charged, e.g. a treatment or "Visit on 9 Nov"
  total_amount   Numeric(12, 2)
  status         InvoiceStatus              @default(Unpaid)
  due_date       DateString?
  created_at     temporal.createdAtString()
  updated_at     temporal.updatedAtString()
  deleted_at     TimestamptzString?

  payments Payment[]

  @@index([clinic_id])
  @@index([patient_id])
  @@index([appointment_id])
}

model Payment {
  id             String                     @id @default(uuid())
  clinic_id      String
  clinic         Clinic                     @relation(fields: [clinic_id], references: [id])
  invoice_id     String
  invoice        Invoice                    @relation(fields: [invoice_id], references: [id])
  appointment_id String? // The visit the money was received at, if any
  appointment    Appointment?               @relation(fields: [appointment_id], references: [id])
  amount         Numeric(12, 2)
  payment_method PaymentMethod
  payment_date   TimestamptzString
  notes          String?
  created_at     temporal.createdAtString()
  updated_at     temporal.updatedAtString()
  deleted_at     TimestamptzString?

  @@index([clinic_id])
  @@index([invoice_id])
  @@index([appointment_id])
}

# Copy to .env and fill in. Never commit .env (real keys live only there).

# Database (PostgreSQL)
DATABASE_URL=

# Auth.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# Public URL of the app (used in links inside emails), e.g. https://app.example.com
NEXT_PUBLIC_APP_URL=

# File storage: any S3-compatible bucket (Cloudflare R2, AWS S3, MinIO...)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Email (Resend). Without EMAIL_API_KEY, development prints emails to the server log;
# production refuses to send.
EMAIL_API_KEY=
# Sender on a domain verified in Resend, e.g. "BienSync <no-reply@example.com>".
# Empty: Resend's test sender (delivers only to your own Resend account email).
EMAIL_FROM=
